#!/usr/bin/env bash
# Build a standalone ux-ui-agent-skills kit for OpenCode from the Claude plugin cache.
#
# The plugin's skills call ${CLAUDE_SKILL_DIR}, which only Claude Code defines.
# This copies the kit, rewrites that variable to absolute paths in the COPY
# (the plugin cache is never modified), and links each skill into ~/.agents/skills.
#
# Idempotent: it records the plugin version and a content fingerprint. When
# neither changed since the last successful sync, it exits without touching
# anything. Safe to run from topgrade on every update.
#
# Usage:
#   sync-ux-ui-skills              sync only if the plugin changed
#   sync-ux-ui-skills --force      sync even if nothing changed
#   sync-ux-ui-skills --dry-run    show what would happen, change nothing
#
# Env:
#   UX_UI_VERSION=3.1.0            pin a plugin version (default: newest installed)
set -euo pipefail

PLUGIN_BASE="${HOME}/.claude/plugins/cache/ux-ui-agent-skills/ux-ui-agent-skills"
KIT_DIR="${HOME}/.agents/kits/ux-ui-agent-skills"
SKILLS_DIR="${HOME}/.agents/skills"
BACKUP_DIR="${HOME}/.agents/.backup-ux-ui"
LOCK_FILE="${HOME}/.agents/.skill-lock.json"
STATE_FILE="${KIT_DIR}/.synced"
OWNER="plugin87/ux-ui-agent-skills"
VAR='${CLAUDE_SKILL_DIR}'

force=0
dry_run=0
for arg in "$@"; do
  case "$arg" in
    --force) force=1 ;;
    --dry-run) dry_run=1 ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    *) echo "sync-ux-ui-skills: unknown option: $arg" >&2; exit 2 ;;
  esac
done

log() { echo "sync-ux-ui-skills: $*"; }

# 1. Resolve the plugin version.
VERSION="${UX_UI_VERSION:-}"
if [ -z "$VERSION" ] && [ -d "$PLUGIN_BASE" ]; then
  VERSION=$(ls -1 "$PLUGIN_BASE" | sort -V | tail -n 1)
fi
SRC="$PLUGIN_BASE/$VERSION"
if [ -z "$VERSION" ] || [ ! -d "$SRC/.claude/skills" ]; then
  echo "sync-ux-ui-skills: plugin not found under $PLUGIN_BASE (install ux-ui-agent-skills in Claude Code first)" >&2
  exit 1
fi

# 2. Fingerprint the whole plugin tree (minus node_modules and .git): version + every file hash.
fingerprint=$(
  cd "$SRC" && {
    echo "version=$VERSION"
    find . -type f -not -path './node_modules/*' -not -path './.git/*' -print0 \
      | sort -z | xargs -0 sha256sum
  } | sha256sum | cut -d' ' -f1
)

# 3. Nothing changed since the last sync: do nothing.
if [ "$force" -eq 0 ] && [ -f "$STATE_FILE" ] && [ "$(cat "$STATE_FILE")" = "$fingerprint" ]; then
  log "v$VERSION unchanged since last sync, nothing to do"
  exit 0
fi

# 4. Ask the lock file who owns a skill name, so we never replace another source's skill.
owner_of() {
  python3 -I - "$LOCK_FILE" "$1" <<'PY' 2>/dev/null || true
import json, sys
try:
    skills = json.load(open(sys.argv[1]))["skills"]
except Exception:
    skills = {}
print(skills.get(sys.argv[2], {}).get("source", ""))
PY
}

# 5. Decide the plan for each skill in the plugin.
plan_names=()
plan_actions=()
for skill in "$SRC"/.claude/skills/*/; do
  name=$(basename "$skill")
  [ -f "$skill/SKILL.md" ] || continue
  dest="$SKILLS_DIR/$name"
  if [ -L "$dest" ]; then
    action="link"
  elif [ -e "$dest" ]; then
    if [ "$(owner_of "$name")" = "$OWNER" ]; then
      action="replace"   # our own earlier npx copy: back it up, then link
    else
      action="skip"      # another source owns this name: leave it alone
    fi
  else
    action="link"
  fi
  plan_names+=("$name")
  plan_actions+=("$action")
done

if [ "$dry_run" -eq 1 ]; then
  log "dry run, v$VERSION"
  for i in "${!plan_names[@]}"; do
    echo "  ${plan_actions[$i]}  ${plan_names[$i]}"
  done
  exit 0
fi

# 6. Copy the kit and rewrite the variable in the copy only.
mkdir -p "$KIT_DIR" "$SKILLS_DIR"
log "syncing v$VERSION -> $KIT_DIR"
rsync -a --delete --exclude node_modules --exclude .git --exclude .synced "$SRC/" "$KIT_DIR/"

# Local patch: gates launch system Chrome at /opt/google/chrome, which needs root to install.
# When DS_CHROME_PATH is set, use that binary instead (e.g. Playwright's Chromium).
# Without the variable the launch behaves exactly as upstream.
PATCH_FROM="chromium.launch({ channel: 'chrome' })"
PATCH_TO="chromium.launch(process.env.DS_CHROME_PATH ? { executablePath: process.env.DS_CHROME_PATH } : { channel: 'chrome' })"
patched=0
while IFS= read -r f; do
  sed -i "s|$PATCH_FROM|$PATCH_TO|g" "$f"
  patched=$((patched + 1))
done < <(grep -rlF "$PATCH_FROM" "$KIT_DIR/scripts" || true)
log "DS_CHROME_PATH patch applied to $patched script(s)"

# Local patch: examples/component-states/misc.html renders its value readout in
# --color-text-secondary, which measures 2.92:1 on white (WCAG needs 3:1 here).
# Use text-primary for that readout. Warn, do not fail, if upstream changed the line.
#
# The state-aware gate reads the range slider's own color property as its text
# color (its value "65" is the label it reports). Setting color on the slider
# to text-primary gives that reading a contrast that meets 3:1. The visible
# track and thumb still use accent-color, unchanged.
MISC="$KIT_DIR/examples/component-states/misc.html"
misc_patch() {
  local from="$1" to="$2"
  if [ -f "$MISC" ] && grep -qF "$from" "$MISC"; then
    local pattern
    pattern=$(printf '%s' "$from" | sed 's/[][\.*^$|]/\\&/g')
    sed -i "s|$pattern|$to|" "$MISC"
    log "contrast patch applied to misc.html"
  else
    log "warning: misc.html contrast patch not applied (upstream line changed or file missing)"
  fi
}
misc_patch \
  '.val{font-size:var(--text-sm);color:var(--color-text-secondary)}' \
  '.val{font-size:var(--text-sm);color:var(--color-text-primary)}'
misc_patch \
  'input[type=range]{inline-size:100%;accent-color:var(--color-action-primary);height:1.5rem}' \
  'input[type=range]{inline-size:100%;accent-color:var(--color-action-primary);height:1.5rem;color:var(--color-text-primary);background:var(--color-surface-page)}'

# Dependencies live in the kit, not in the plugin cache: npm must never write there.
if [ -f "$KIT_DIR/package-lock.json" ]; then
  log "installing kit dependencies (npm ci)"
  (cd "$KIT_DIR" && npm ci --no-audit --no-fund --loglevel=error)
fi

for i in "${!plan_names[@]}"; do
  name="${plan_names[$i]}"
  action="${plan_actions[$i]}"
  abs="$KIT_DIR/.claude/skills/$name"
  dest="$SKILLS_DIR/$name"

  while IFS= read -r f; do
    sed -i "s|\\\${CLAUDE_SKILL_DIR}|$abs|g" "$f"
  done < <(grep -rlF "$VAR" "$abs" || true)

  case "$action" in
    skip)
      log "skipped $name: owned by another source (see $LOCK_FILE)"
      continue
      ;;
    replace)
      mkdir -p "$BACKUP_DIR"
      rm -rf "$BACKUP_DIR/$name"
      mv "$dest" "$BACKUP_DIR/$name"
      log "backed up previous $name -> $BACKUP_DIR/$name"
      ;;
  esac
  ln -sfn "$abs" "$dest"
done

# 7. Remove links into the kit for skills that no longer exist there.
find "$SKILLS_DIR" -maxdepth 1 -type l | while IFS= read -r link; do
  target=$(readlink "$link")
  case "$target" in
    "$KIT_DIR"/*)
      if [ ! -e "$target" ]; then
        rm -f "$link"
        log "removed stale link $(basename "$link")"
      fi
      ;;
  esac
done

# 8. Record the fingerprint only after everything succeeded.
echo "$fingerprint" > "$STATE_FILE"
log "done, ${#plan_names[@]} skills in plugin v$VERSION"
