#!/bin/bash
set -euo pipefail

LATEST=$(curl -fs https://api.github.com/repos/bitwarden/clients/releases |
  jq -r '[.[] | select(.tag_name | startswith("cli-v"))][0].tag_name | ltrimstr("cli-v")')
CURRENT=$(bw --version 2>/dev/null || true)

[[ "$LATEST" == "$CURRENT" ]] && {
  echo "bw $CURRENT is up to date"
  exit 0
}

echo "Installing bw v$LATEST (current: ${CURRENT:-none})..."
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
curl -fLo "$TMP/bw.zip" \
  "https://github.com/bitwarden/clients/releases/download/cli-v${LATEST}/bw-linux-${LATEST}.zip"
unzip -o "$TMP/bw.zip" -d ~/.local/bin/
chmod +x ~/.local/bin/bw
echo "Done: $(bw --version)"
