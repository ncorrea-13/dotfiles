# --------------------------
# Launchers Block (floating TUI utilities, wezterm)
# --------------------------

# Monitor control
bindsym XF86Display exec $screentui_cmd
bindsym $mod+shift+p exec $screentui_cmd

# Music control (kept alive)
bindsym $mod+m exec ~/.config/sway/scripts/scratchpad-toggle.sh ncspot $ncspot_cmd

# Wifi Menu
bindsym $mod+w exec $nmrstui_cmd

# Bluetooth Menu
bindsym $mod+b exec $bluetui_cmd

# Clipboard history
bindsym $mod+v exec $clipboardtui_cmd

# Calendar
bindsym $mod+c exec $callendar

# Bitwarden (kept alive)
bindsym $mod+Shift+b exec ~/.config/sway/scripts/scratchpad-toggle.sh bitwarden $bitwarden_cmd

# System update (kept alive)
bindsym $mod+u exec ~/.config/sway/scripts/scratchpad-toggle.sh topgrade $topgrade_cmd

# System monitor
bindsym $mod+t exec $btop_cmd

# YouTube TUI
bindsym $mod+Shift+y exec $ytsurf_cmd

# Nchat (kept alive)
bindsym $mod+Shift+n exec $nchatpicker_cmd

# concord (kept alive)
bindsym $mod+Shift+d exec ~/.config/sway/scripts/scratchpad-toggle.sh concord $concord_cmd

# ekphos (obsidian-related)
bindsym $mod+Shift+o exec $ekphos_cmd

# jocalsend (localsend-alike)
bindsym $mod+Shift+t exec $jocalsend_cmd

# weather
bindsym $mod+Shift+w exec $weather_cmd

# auto-cpufreq stats
bindsym $mod+Shift+f exec $autocpufreq_cmd

# Keybindings cheatsheet
bindsym $mod+shift+c exec $keybindshelp_cmd
