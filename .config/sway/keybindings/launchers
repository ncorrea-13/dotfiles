# --------------------------
# Launchers Block (floating TUI utilities, wezterm)
# --------------------------

# Monitor control
bindsym XF86Display exec $screentui_cmd
bindsym $mod+shift+p exec $screentui_cmd

# Music control (kept alive: toggles to/from the scratchpad instead of relaunching)
bindsym $mod+m exec ~/.config/sway/scripts/scratchpad-toggle.sh ncspot $ncspot_cmd

# Wifi Menu
bindsym $mod+w exec $nmrstui_cmd

# Bluetooth Menu
bindsym $mod+b exec $bluetui_cmd

# System update (kept alive: toggles to/from the scratchpad instead of relaunching)
bindsym $mod+u exec ~/.config/sway/scripts/scratchpad-toggle.sh topgrade $topgrade_cmd

# System monitor
bindsym $mod+t exec $btop_cmd
