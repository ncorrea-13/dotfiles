# Mod keys
set $mod Mod4
set $alt Mod1

# Vim keys
set $left h
set $down j
set $up k
set $right l

# Fonts
font pango:JetbrainsMono Nerd Font Bold 12

# Cursor
set $cursor_theme oreo
seat * xcursor_theme $cursor_theme 24

# Applications
set $term wezterm
set $files thunar
set $browser mullvad-browser
set $librewolf librewolf
set $discord discord --enable-features=UseOzonePlatform --ozone-platform=wayland
set $notes ~/.local/bin/obsidian
set $youtube ~/.local/bin/freetube
set $lock rustlock-script
set $menu  rofi -show drun

# Floating TUI launchers
set $callendar wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=110 --config initial_rows=32 start --always-new-process --class ikhal -- /bin/ikhal
set $bluetui_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=110 --config initial_rows=32 start --always-new-process --class bluetui -- ~/.cargo/bin/bluetui
set $nmrstui_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=110 --config initial_rows=32 start --always-new-process --class nmrs-tui -- ~/.cargo/bin/nmrs-tui
set $btop_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=140 --config initial_rows=40 start --always-new-process --class btop -- btop
set $screentui_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=60 --config initial_rows=15 start --always-new-process --class screen-tui -- ~/.config/sway/scripts/screen-tui.sh
set $ncspot_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=100 --config initial_rows=32 start --always-new-process --class ncspot -- ~/.local/bin/ncspot
set $topgrade_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=120 --config initial_rows=36 start --always-new-process --class topgrade -- bash -c '~/.local/bin/topgrade; exec sleep 5'
set $applauncher_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=70 --config initial_rows=20 start --always-new-process --class app-launcher -- ~/.config/sway/scripts/app-launcher.sh
set $powermenu_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=50 --config initial_rows=14 start --always-new-process --class powermenu -- ~/.config/sway/scripts/powermenu.sh
set $screenshottui_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=50 --config initial_rows=14 start --always-new-process --class screenshot-tui -- ~/.config/sway/scripts/screenshot-tui.sh
set $clipboardtui_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=90 --config initial_rows=24 start --always-new-process --class clipboard-tui -- ~/.config/sway/scripts/clipboard-tui.sh
set $bitwarden_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=90 --config initial_rows=28 start --always-new-process --class bitwarden -- ~/.local/bin/bw-tui
set $ytsurf_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=100 --config initial_rows=32 start --always-new-process --class ytsurf -- ~/.local/bin/ytsurf
set $nchatpicker_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=50 --config initial_rows=14 start --always-new-process --class nchat-picker -- ~/.config/sway/scripts/nchat-picker.sh
set $concord_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=110 --config initial_rows=34 start --always-new-process --class concord -- env ALSA_PLUGIN_DIR=/usr/lib/x86_64-linux-gnu/alsa-lib ~/.local/bin/concord
set $ekphos_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=90 --config initial_rows=28 start --always-new-process --class ekphos -- ~/.cargo/bin/ekphos
set $jocalsend_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=90 --config initial_rows=28 start --always-new-process --class jocalsend -- ~/.cargo/bin/jocalsend
set $autocpufreq_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=100 --config initial_rows=30 start --always-new-process --class auto-cpufreq -- auto-cpufreq --stats
set $keybindshelp_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=110 --config initial_rows=32 start --always-new-process --class keybinds-help -- ~/.config/sway/scripts/keybinds-tui.sh
set $swaytab_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=70 --config initial_rows=20 start --always-new-process --class sway-tab -- ~/.config/sway/scripts/sway-tab.sh
set $weather_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=70 --config initial_rows=35 start --always-new-process --class weather -- ~/.local/share/go/bin/weathertui
set $volume_cmd wezterm --config-file ~/.config/wezterm/tui-popup.lua --config initial_cols=80 --config initial_rows=30 start --always-new-process --class weather -- ~/.cargo/bin/wiremix

# Gaps and Borders
gaps inner 6
gaps outer 3
default_border pixel 1
default_floating_border pixel 1

# Blur, rounded corners, and shadows
blur disable
blur_passes 5
blur_radius 3

corner_radius 10

shadows enable
shadow_offset 5 5
shadow_color #111111
shadow_inactive_color #0000004F

default_dim_inactive 0.3
for_window [app_id=".*"] opacity 1

# Floating TUI utilities
for_window [app_id="^bluetui$"] floating enable, move position center, border pixel 1
for_window [app_id="^nmrs-tui$"] floating enable, move position center, border pixel 1
for_window [app_id="^btop$"] floating enable, move position center, border pixel 1
for_window [app_id="^ikhal$"] floating enable, move position center, border pixel 1
for_window [app_id="^ncspot$"] floating enable, move position center, border pixel 1, move to scratchpad, scratchpad show
for_window [app_id="^topgrade$"] floating enable, move position center, border pixel 1, move to scratchpad, scratchpad show
for_window [app_id="^screen-tui$"] floating enable, move position center, border pixel 1
for_window [app_id="^app-launcher$"] floating enable, move position center, border pixel 1
for_window [app_id="^powermenu$"] floating enable, move position center, border pixel 1
for_window [app_id="^screenshot-tui$"] floating enable, move position center, border pixel 1
for_window [app_id="^clipboard-tui$"] floating enable, move position center, border pixel 1
for_window [app_id="^bitwarden$"] floating enable, move position center, border pixel 1, move to scratchpad, scratchpad show
for_window [app_id="^ytsurf$"] floating enable, move position center, border pixel 1
for_window [app_id="^nchat$"] floating enable, move position center, border pixel 1, move to scratchpad, scratchpad show
for_window [app_id="^nchat-picker$"] floating enable, move position center, border pixel 1
for_window [app_id="^concord$"] floating enable, move position center, border pixel 1, move to scratchpad, scratchpad show
for_window [app_id="^ekphos$"] floating enable, move position center, border pixel 1
for_window [app_id="^jocalsend$"] floating enable, move position center, border pixel 1
for_window [app_id="^auto-cpufreq$"] floating enable, move position center, border pixel 1
for_window [app_id="^keybinds-help$"] floating enable, move position center, border pixel 1
for_window [app_id="^sway-tab$"] floating enable, move position center, border pixel 1
for_window [app_id="^weather$"] floating enable, move position center, border pixel 1, move to scratchpad, scratchpad show

