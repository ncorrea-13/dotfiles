output eDP-1 scale 1
output HDMI-A-2 enable
output eDP-1 pos 0 0
output HDMI-A-2 pos 1366 0

# Assign workspaces to the external monitor.
# This is for a notebook with the internal display eDP-1 and an external monitors DP-1 via USB-C.
workspace 1 output HDMI-A-2
workspace 2 output HDMI-A-2
workspace 3 output HDMI-A-2
workspace 4 output eDP-1
workspace 5 output HDMI-A-2
workspace 6 output eDP-1
workspace 7 output eDP-1
workspace 8 output eDP-1
workspace 9 output HDMI-A-2
workspace 10 output eDP-1
